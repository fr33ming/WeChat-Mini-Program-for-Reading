/* ====================== 页面容器 ====================== */
.container {
  padding-bottom: 40rpx;  /* 页面底部留白，避免内容贴住屏幕底边 */
}

/* 只在本页生效的背景图：固定铺满一屏，不随内容滚动拉伸 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;           /* 垫在所有内容下面 */
  pointer-events: none;  /* 不挡按钮和点击 */
}

/* ====================== 顶部海报 ====================== */
.poster {
  display: block;
  width: 100%;              /* 海报通栏展示，高度按原图比例自适应 */
  margin-bottom: 24rpx;     /* 海报下面空一小行 */
}

/* ====================== 单条书籍卡片 ====================== */
.book-card {
  display: flex;
  background: rgba(255, 253, 248, 0.85);
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.book-cover {
  width: 140rpx;
  height: 190rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: rgba(243, 230, 196, 0.85); /* 图片加载前的底色 */
}

.book-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.book-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.book-author {
  font-size: 24rpx;
  color: #8A7A5C;
  margin-bottom: 8rpx;
}

.book-desc {
  font-size: 22rpx;
  color: #B3A687;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}

.book-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
