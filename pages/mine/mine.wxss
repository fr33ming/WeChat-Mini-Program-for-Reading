/* ====================== 页面容器 ====================== */
.container {
  padding: 24rpx;
}

/* 只在本页生效的背景图：固定铺满一屏，不随内容滚动拉伸 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;           /* 垫在所有内容下面 */
  pointer-events: none;  /* 不挡按钮和点击 */
}

/* ====================== 个人信息头部卡片 ====================== */
.profile-header {
  display: flex;                /* 横向布局：头像+个人信息 */
  align-items: center;
  background: rgba(184, 134, 11, 0.9); /* 纸黄棕主题色（半透明，透出背景图） */
  border-radius: 24rpx;
  padding: 30rpx;
  color: white;
  margin-bottom: 24rpx;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;          /* 圆形头像 */
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;     /* 头像内图标居中 */
  font-size: 50rpx;
}
.profile-info {
  margin-left: 20rpx;
}
.name {
  font-size: 36rpx;
  font-weight: bold;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;                 /* 名字与改名按钮的间距 */
}
.edit-name {
  font-size: 22rpx;
  color: #FFFDF8;
  opacity: 0.8;               /* 浅色小字，弱化但可点 */
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  border-radius: 24rpx;
}
.desc {
  font-size: 24rpx;
  opacity: 0.8;                /* 简介文字降低透明度 */
}

/* ====================== Tab切换栏 ====================== */
.tab-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.mine-tab {
  flex: 1;                     /* tab标签等分宽度 */
  padding: 16rpx;
  text-align: center;
  border-radius: 40rpx;
  background: rgba(255, 253, 248, 0.75);
  color: #8A7A5C;
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid #E7D9B8;
}
.mine-tab.active {
  background: rgba(184, 134, 11, 0.9); /* 选中tab主题色背景（半透明） */
  color: white;
  border-color: #B8860B;
}

/* ====================== 收藏/喜欢类型筛选条 ====================== */
.type-filter {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.type-filter-btn {
  padding: 10rpx 32rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(240, 230, 206, 0.8);
  color: #8A7A5C;
  border: 2rpx solid #E7D9B8;
}
.type-filter-btn.active {
  background: rgba(184, 134, 11, 0.9);
  color: white;
  border-color: #B8860B;
}

/* ====================== 列表公共项样式 ====================== */
.read-item, .comment-item {
  display: flex;
  flex-direction: column;
  background: rgba(255, 253, 248, 0.85); /* 半透明卡片，透出背景图 */
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.read-item {
  flex-direction: row;         /* 已读书籍：封面+文字横向排布 */
  align-items: center;
}
.book-cover {
  width: 80rpx;
  height: 110rpx;
  border-radius: 8rpx;
  flex-shrink: 0;              /* 封面禁止压缩变形 */
  background: rgba(243, 230, 196, 0.85);         /* 图片加载前的底色 */
}
.info {
  margin-left: 16rpx;
  flex: 1;                     /* 占据剩余宽度 */
}
.title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A3B22;
}
.subtitle {
  font-size: 22rpx;
  color: #B3A687;
  margin-top: 6rpx;
}

/* ====================== 时间小字（随笔/收藏条目共用） ====================== */
.review-time {
  font-size: 22rpx;
  color: #B3A687;
  margin-top: 8rpx;
}

/* ====================== 评论条目样式 ====================== */
.comment-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.comment-type {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.comment-type.reading {
  background: rgba(243, 230, 196, 0.85);
  color: #96710A;
}
.comment-type.review {
  background: rgba(253, 235, 208, 0.85);
  color: #C77B1E;
}
.comment-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A3B22;
}
.comment-book {
  font-size: 24rpx;
  color: #8A7A5C;
  margin-top: 10rpx;
}

/* ====================== 空状态 ====================== */
.empty-state {
  background: rgba(255, 253, 248, 0.85);
  border-radius: 16rpx;
  padding: 60rpx 20rpx;
  text-align: center;
  color: #B3A687;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}
