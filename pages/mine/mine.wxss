/* ====================== 页面容器 ====================== */
.container {
  padding: 24rpx;
}

/* ====================== 个人信息头部卡片 ====================== */
.profile-header {
  display: flex;                /* 横向布局：头像+个人信息 */
  align-items: center;
  background: #00B894;
  border-radius: 24rpx;
  padding: 30rpx;
  color: white;
  margin-bottom: 24rpx;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;          /* 圆形头像 */
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;     /* 头像内图标居中 */
  font-size: 50rpx;
}
.profile-info {
  margin-left: 20rpx;
}
.name {
  font-size: 36rpx;
  font-weight: bold;
}
.desc {
  font-size: 24rpx;
  opacity: 0.8;                /* 简介文字降低透明度 */
}

/* ====================== 阅读统计模块 ====================== */
.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.stat-box {
  flex: 1;                     /* 三个统计盒子等分宽度 */
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #00B894;
  display: block;              /* 数字独占一行 */
}
.stat-label {
  font-size: 22rpx;
  color: #B2BEC3;
}

/* ====================== Tab切换栏 ====================== */
.tab-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.mine-tab {
  flex: 1;                     /* tab标签等分宽度 */
  padding: 16rpx;
  text-align: center;
  border-radius: 40rpx;
  background: #fff;
  color: #636E72;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid #E8E8E8;
}
.mine-tab.active {
  background: #00B894;         /* 选中tab主题色背景 */
  color: white;
  border-color: #00B894;
}

/* ====================== 列表公共项样式 ====================== */
.read-item, .review-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.book-cover {
  width: 80rpx;
  height: 110rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  flex-shrink: 0;              /* 封面禁止压缩变形 */
}
.info {
  margin-left: 16rpx;
  flex: 1;                     /* 占据剩余宽度 */
}
.title {
  font-size: 28rpx;
  font-weight: bold;
}
.subtitle {
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 6rpx;
}

/* ====================== 评价条目样式 ====================== */
.review-header {
  display: flex;
  align-items: center;
  justify-content: space-between; /* 标题居左，星级居右 */
}
.stars {
  color: #FDCB6E;                /* 星级金黄色 */
}
.review-content {
  font-size: 26rpx;
  color: #2D3436;
  margin-top: 12rpx;
  background: #F8F9FA;           /* 评价内容浅灰背景 */
  padding: 16rpx;
  border-radius: 8rpx;
}
.review-time {
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 8rpx;
}
