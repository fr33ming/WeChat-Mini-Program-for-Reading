/* ====================== 页面容器 ====================== */
.container {
  padding: 24rpx;
}

/* ====================== 个人信息头部卡片 ====================== */
.profile-header {
  display: flex;                /* 横向布局：头像+个人信息 */
  align-items: center;
  background: #B8860B;          /* 纸黄棕主题色 */
  border-radius: 24rpx;
  padding: 30rpx;
  color: white;
  margin-bottom: 24rpx;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;          /* 圆形头像 */
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;     /* 头像内图标居中 */
  font-size: 50rpx;
}
.profile-info {
  margin-left: 20rpx;
}
.name {
  font-size: 36rpx;
  font-weight: bold;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;                 /* 名字与改名按钮的间距 */
}
.edit-name {
  font-size: 22rpx;
  color: #FFFDF8;
  opacity: 0.8;               /* 浅色小字，弱化但可点 */
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  border-radius: 24rpx;
}
.desc {
  font-size: 24rpx;
  opacity: 0.8;                /* 简介文字降低透明度 */
}

/* ====================== 个人纪录入口 ====================== */
.records-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFDF8;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.records-entry-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3B22;
}
.records-entry-arrow {
  font-size: 40rpx;
  color: #B3A687;
  line-height: 1;
}
