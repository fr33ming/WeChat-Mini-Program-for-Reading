<view class="container">
  <!-- 个人信息 -->
  <view class="profile-header">
    <view class="avatar">📚</view>
    <view class="profile-info">
      <view class="name">阅读爱好者</view>
      <view class="desc">坚持阅读，遇见更好的自己</view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats-row">
    <view class="stat-box">
      <text class="stat-number">{{readCount}}</text>
      <text class="stat-label">已读书籍</text>
    </view>
    <view class="stat-box">
      <text class="stat-number">{{reviewCount}}</text>
      <text class="stat-label">我的评价</text>
    </view>
  </view>

  <!-- 标签页 -->
  <view class="tab-row">
    <view class="mine-tab {{activeTab === 'read' ? 'active' : ''}}" bindtap="switchTab" data-tab="read">📖 已读书籍</view>
    <view class="mine-tab {{activeTab === 'review' ? 'active' : ''}}" bindtap="switchTab" data-tab="review">⭐ 我的评价</view>
  </view>

  <!-- 已读书籍列表 -->
  <view wx:if="{{activeTab === 'read'}}">
    <view wx:if="{{readBooks.length === 0}}" class="empty-state">
      <view class="empty-icon">📭</view>
      <view>还没有已读书籍，去书籍推荐看看吧！</view>
    </view>
    <view class="read-item" wx:for="{{readBooks}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="book-cover" style="background: {{item.coverColor}}">{{item.cover}}</view>
      <view class="info">
        <view class="title">{{item.title}}</view>
        <view class="subtitle">{{item.author}} · {{item.category}}</view>
      </view>
    </view>
  </view>

  <!-- 我的评价列表 -->
  <view wx:if="{{activeTab === 'review'}}">
    <view wx:if="{{userReviews.length === 0}}" class="empty-state">
      <view class="empty-icon">⭐</view>
      <view>还没有评价，去书籍详情页写一条吧！</view>
    </view>
    <view class="review-item" wx:for="{{userReviews}}" wx:key="index" bindtap="goToDetail" data-id="{{item.bookId}}">
      <view class="review-header">
        <text class="book-title">{{item.bookTitle}}</text>
        <text class="stars">{{item.stars}}</text>
      </view>
      <view class="review-content">{{item.content}}</view>
      <view class="review-time">{{item.time}}</view>
    </view>
  </view>
</view>