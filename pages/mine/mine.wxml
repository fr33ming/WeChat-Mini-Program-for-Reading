<view class="container">
  <!-- 个人信息 -->
  <view class="profile-header">
    <view class="avatar">📚</view>
    <view class="profile-info">
      <view class="name-row">
        <text class="name">{{myNickname}}</text>
        <text class="edit-name" bindtap="onEditName">✏️ 改名</text>
      </view>
      <view class="desc">坚持阅读，遇见更好的自己</view>
    </view>
  </view>

  <!-- 个人纪录入口（统计与个人内容都在这个新页面） -->
  <view class="records-entry" bindtap="goToRecords">
    <text class="records-entry-label">📊 个人记录</text>
    <text class="records-entry-arrow">›</text>
  </view>
</view>
