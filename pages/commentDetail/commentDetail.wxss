/* ====================== 页面容器 ====================== */
.container {
  padding: 24rpx;
}

/* ====================== 评论正文卡片 ====================== */
.comment-card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.comment-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.comment-type {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.comment-type.reading {
  background: #F3E6C4;
  color: #96710A;
}
.comment-type.review {
  background: #FDEBD0;
  color: #C77B1E;
}
.comment-title {
  font-size: 34rpx;
  font-weight: bold;
}
.comment-book {
  font-size: 24rpx;
  color: #8A7A5C;
  margin: 16rpx 0 8rpx;
}
.comment-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #B3A687;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0E6CE;
}
.comment-body {
  font-size: 28rpx;
  color: #4A3B22;
  line-height: 1.8;
  padding: 24rpx 0;
}

/* ====================== 点赞/收藏按钮行 ====================== */
.action-row {
  display: flex;
  gap: 20rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 40rpx;
  background: #F8F1E1;
  color: #8A7A5C;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid #E7D9B8;
}
.action-btn.active {
  background: #FDEBD0;
  color: #C77B1E;
  border-color: #C77B1E;
}

/* ====================== 评论区 ====================== */
.section {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.section-label {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}
.comment-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.comment-input {
  flex: 1;
  height: 72rpx;
  background: #F8F1E1;
  border: 2rpx solid #E7D9B8;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}
.send-btn {
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  background: #B8860B;
  color: white;
  font-size: 26rpx;
  font-weight: 600;
}
.send-btn:active {
  background: #96710A;
}

.comment-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0E6CE;
}
.comment-item:last-child {
  border-bottom: none;
}
.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.comment-user {
  font-size: 26rpx;
  font-weight: 600;
  color: #96710A;
}
.comment-time {
  font-size: 22rpx;
  color: #B3A687;
}
.comment-content {
  font-size: 26rpx;
  color: #4A3B22;
  line-height: 1.6;
  margin-top: 10rpx;
}
