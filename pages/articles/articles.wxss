/* ====================== 页面容器 ====================== */
.container {
  padding: 24rpx;
}

/* ====================== 板块切换栏 ====================== */
.tab-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.mine-tab {
  flex: 1;                     /* 板块标签等分宽度 */
  padding: 16rpx;
  text-align: center;
  border-radius: 40rpx;
  background: #FFFDF8;
  color: #8A7A5C;
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid #E7D9B8;
}
.mine-tab.active {
  background: #B8860B;         /* 选中板块主题色背景 */
  color: white;
  border-color: #B8860B;
}

/* ====================== 推文卡片 ====================== */
.article-card {
  display: flex;
  background: #FFFDF8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.article-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  flex-shrink: 0;              /* 封面禁止压缩变形 */
}
.article-info {
  margin-left: 20rpx;
  flex: 1;                     /* 占据剩余宽度 */
  display: flex;
  flex-direction: column;
}
.article-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A3B22;
  line-height: 1.4;
}
.article-summary {
  font-size: 24rpx;
  color: #8A7A5C;
  margin-top: 8rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;       /* 摘要最多两行，超出省略 */
  overflow: hidden;
}
.article-meta {
  font-size: 22rpx;
  color: #B3A687;
  margin-top: 12rpx;
}

/* ====================== 空状态 ====================== */
.empty-state {
  background: #FFFDF8;
  border-radius: 16rpx;
  padding: 60rpx 20rpx;
  text-align: center;
  color: #B3A687;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}
