/* ====================== 页面容器 ====================== */
.container {
  padding: 24rpx;
}

/* 只在本页生效的背景图：固定铺满一屏，不随内容滚动拉伸 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;           /* 垫在所有内容下面 */
  pointer-events: none;  /* 不挡按钮和点击 */
}

/* ====================== 板块切换栏 ====================== */
.tab-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
/* 板块图片入口：未选中半透明，选中高亮加金框 */
.tab-item {
  position: relative;
  flex: 1;
  height: 130rpx;
  border-radius: 16rpx;
  overflow: hidden;
  opacity: 0.6;
}
.tab-img {
  width: 100%;
  height: 100%;
}
/* 图片上的板块文本：居中纯文字，黑色 */
.tab-label {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #000000;
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 8rpx;
}
.tab-img-active {
  opacity: 1;
  box-shadow: 0 0 0 4rpx #B8860B;
}

/* ====================== 推文卡片 ====================== */
.article-card {
  display: flex;
  background: rgba(255, 253, 248, 0.85);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
/* 封面：本地图片 */
.article-cover-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;              /* 封面禁止压缩变形 */
  background: rgba(243, 230, 196, 0.85);         /* 图片加载前的底色 */
}
.article-info {
  margin-left: 20rpx;
  flex: 1;                     /* 占据剩余宽度 */
  display: flex;
  flex-direction: column;
}
.article-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A3B22;
  line-height: 1.4;
}
.article-summary {
  font-size: 24rpx;
  color: #8A7A5C;
  margin-top: 8rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;       /* 摘要最多两行，超出省略 */
  overflow: hidden;
}
.article-meta {
  font-size: 22rpx;
  color: #B3A687;
  margin-top: 12rpx;
}

/* ====================== 空状态 ====================== */
.empty-state {
  background: rgba(255, 253, 248, 0.85);
  border-radius: 16rpx;
  padding: 60rpx 20rpx;
  text-align: center;
  color: #B3A687;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}
