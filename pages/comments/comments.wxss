/* ====================== 评论广场 ====================== */
.comment-section {
  margin-top: 30rpx;
}
.comment-header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 24rpx 24rpx 16rpx;
}
.comment-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 16rpx;
}
.comment-sub {
  font-size: 22rpx;
  color: #B3A687;
  flex: 1;
}

.comment-card {
  background: rgba(255, 253, 248, 0.85);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.comment-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.comment-type {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.comment-type.reading {
  background: rgba(243, 230, 196, 0.85);
  color: #96710A;
}
.comment-type.review {
  background: rgba(253, 235, 208, 0.85);
  color: #C77B1E;
}
.comment-card-title {
  font-size: 30rpx;
  font-weight: bold;
}
.comment-book {
  font-size: 22rpx;
  color: #8A7A5C;
  margin: 10rpx 0;
}
.comment-content {
  font-size: 26rpx;
  color: #4A3B22;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.6;
}
.comment-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #B3A687;
}
.comment-user {
  color: #8A7A5C;
  font-weight: 600;
}
.comment-stat {
  margin-left: auto;
}

/* ====================== 空状态 ====================== */
.empty-state {
  background: rgba(255, 253, 248, 0.85);
  border-radius: 16rpx;
  padding: 60rpx 20rpx;
  margin: 0 24rpx 20rpx;
  text-align: center;
  color: #B3A687;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}
