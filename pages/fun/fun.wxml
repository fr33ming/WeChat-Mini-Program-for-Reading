<view class="container">
  <view class="section-title">🎯 发现有趣的功能</view>
  <view class="fun-grid">
  
    <view class="fun-card featured" bindtap="comingSoon">
      <text class="fun-icon">📖</text>
      <view class="fun-info">
        <text class="fun-name">阅读测试</text>
        <text class="fun-desc">测试你的阅读水平，看看你是哪种阅读达人！</text>
      </view>
    </view>

    <view class="fun-card" bindtap="goToEssay">
      <text class="fun-icon">🎲</text>
      <text class="fun-name">随笔广场</text>
      <text class="fun-desc">看看大家写了什么</text>
    </view>

    <view class="fun-card" bindtap="comingSoon">
      <text class="fun-icon">📺</text>
      <text class="fun-name">AI微课</text>
      <text class="fun-desc">数字资源等着你</text>
    </view>
    
    <view class="fun-card" bindtap="goToFeedback">
      <text class="fun-icon">📝</text>
      <text class="fun-name">活动反馈</text>
      <text class="fun-desc">期待你的意见</text>
    </view>

  </view>
</view>