/* ====================== 页面容器 ====================== */
.container {
  padding: 24rpx;
}

/* ====================== 区块标题 ====================== */
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

/* ====================== 功能网格布局 ====================== */
.fun-grid {
  display: grid;
  grid-template-columns: 1fr 1fr; /* 两列等宽网格 */
  gap: 20rpx;                     /* 格子之间间距 */
}

/* ====================== 普通功能卡片 ====================== */
.fun-card {
  background: #FFFDF8;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 160rpx; /* 卡片最小高度，保证视觉统一 */
}

/* 跨两列的特色大卡片 */
.fun-card.featured {
  grid-column: span 2;        /* 网格占满2列宽度 */
  flex-direction: row;        /* 改为横向排列：图标+文字 */
  background: #B8860B;        /* 纸黄棕主题色 */
  color: white;
  text-align: left;
  padding: 30rpx;
}

/* 功能图标 */
.fun-icon {
  font-size: 50rpx;
  margin-bottom: 10rpx;
}

/* 特色卡片内文字信息容器 */
.fun-info {
  margin-left: 20rpx;
}

/* 功能名称 */
.fun-name {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
}

/* 功能描述 */
.fun-desc {
  font-size: 24rpx;
  opacity: 0.8; /* 描述文字降低透明度弱化 */
}

/* 特色卡片覆盖样式：图标 */
.featured .fun-icon {
  margin-bottom: 0;
  font-size: 60rpx;
}

/* 特色卡片覆盖样式：名称 */
.featured .fun-name {
  color: white;
  font-size: 34rpx;
}

/* 特色卡片覆盖样式：描述 */
.featured .fun-desc {
  font-size: 26rpx;
}