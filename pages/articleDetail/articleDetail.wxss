/* ====================== 页面容器（公众号阅读风格） ====================== */
.page {
  padding: 40rpx 48rpx 80rpx;
}

/* ====================== 文章头部 ====================== */
.article-head {
  padding-bottom: 32rpx;
  border-bottom: 2rpx solid #EFE6D0;
  margin-bottom: 40rpx;
}
.article-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #3B2F1D;
  line-height: 1.5;
}
.article-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #B3A687;
}

/* ====================== 正文三种块 ====================== */
.block-p {
  font-size: 30rpx;
  color: #4A3B22;
  line-height: 1.9;            /* 公众号式宽松行距 */
  margin-bottom: 28rpx;
  text-align: justify;        /* 两端对齐 */
}
.block-h {
  font-size: 32rpx;
  font-weight: bold;
  color: #3B2F1D;
  margin: 40rpx 0 20rpx;      /* 小标题前后留白 */
}
.block-q {
  background: #F7F1E2;
  border-left: 8rpx solid #B8860B; /* 左侧主题色竖线 */
  padding: 20rpx 24rpx;
  margin: 32rpx 0;
  font-size: 28rpx;
  color: #8A7A5C;
  line-height: 1.8;
}
.block-img-wrap {
  margin: 0 -48rpx; /* 突破页面左右内边距（与 .page 的 48rpx 对应），图片通栏显示 */
}
.block-img {
  width: 100%;
  display: block; /* 图片之间不留空隙，连续排版 */
}
.block-img-caption {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #B3A687;
  margin-top: 12rpx;
}

/* ====================== 文末 ====================== */
.article-footer {
  margin-top: 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: #C9BCA0;
}
