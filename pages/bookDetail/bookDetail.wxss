/* ====================== 页面容器 ====================== */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* ====================== 书籍头部信息卡片 ====================== */
.hero {
  display: flex;                /* 横向布局：封面 + 书籍基础信息 */
  width: 100%;                  /* 固定宽度，与下方所有区块完全等宽 */
  box-sizing: border-box;       /* 内边距计入宽度，不撑大盒子 */
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.cover {
  width: 140rpx;
  height: 190rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;     /* 封面文字居中 */
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  flex-shrink: 0;              /* 封面禁止压缩，保持固定尺寸 */
}
.info {
  flex: 1;                     /* 占据剩余宽度 */
  margin-left: 20rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
}
.author {
  font-size: 24rpx;
  color: #636E72;
  margin: 8rpx 0;
}
.tags {
  display: flex;
  flex-wrap: wrap;             /* 标签过多自动换行 */
  gap: 8rpx;
}
.tag {
  background: #F0F0F0;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
}

/* ====================== 已读切换小按钮（头部右上角） ====================== */
.read-toggle {
  align-self: flex-start;      /* 顶到盒子顶部，形成右上角位置 */
  flex-shrink: 0;              /* 禁止被压缩 */
  margin-left: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #E0F4EE;         /* 未读状态：浅青绿底 */
  color: #00A37D;
  border: 2rpx solid #00B894;
}
.read-toggle.is-read {
  background: #00B894;         /* 已读状态：青绿实底 */
  color: #FFFFFF;
  border-color: #00B894;
}

/* ====================== 通用内容区块 ====================== */
.section {
  width: 100%;                  /* 固定宽度，与头部卡片完全等宽 */
  box-sizing: border-box;       /* 内边距计入宽度，不撑大盒子 */
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.section-label {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}
.section-text {
  font-size: 28rpx;
  color: #636E72;
  line-height: 1.6;            /* 行高，提升大段文字可读性 */
}

/* ====================== 书籍信息网格 ====================== */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr; /* 两列等宽网格布局 */
  gap: 12rpx;
  font-size: 26rpx;
  color: #636E72;
}

/* ====================== 评分星星组件 ====================== */
.star-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 20rpx;
}
.star {
  font-size: 48rpx;
  color: #DDD;                  /* 未激活星星灰色 */
}
.star.active {
  color: #FDCB6E;               /* 选中星星金黄色 */
}

/* ====================== 写评价输入区域 ====================== */
.review-textarea {
  width: 100%;
  height: 160rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;       /* padding不会撑开总宽度 */
}
.submit-row {
  display: flex;
  justify-content: center;      /* 提交评价按钮水平居中 */
}

/* ====================== 历史评价列表项 ====================== */
.review-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0; /* 分割线 */
}
.review-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.review-user {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;          /* 圆形头像 */
  background: #00B894;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}
.review-name {
  font-size: 26rpx;
  font-weight: 600;
}
.review-stars {
  margin-left: auto;            /* 推到最右侧 */
  color: #FDCB6E;
  font-size: 26rpx;
}
.review-content {
  font-size: 26rpx;
  color: #2D3436;
  margin: 12rpx 0 8rpx;
}
.review-time {
  font-size: 22rpx;
  color: #B2BEC3;               /* 次要时间浅灰色 */
}