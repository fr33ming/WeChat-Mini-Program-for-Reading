/* ====================== 页面容器 ====================== */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* ====================== 书籍头部信息卡片 ====================== */
.hero {
  display: flex;                /* 横向布局：封面 + 书籍基础信息 */
  width: 100%;                  /* 固定宽度，与下方所有区块完全等宽 */
  box-sizing: border-box;       /* 内边距计入宽度，不撑大盒子 */
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.cover {
  width: 140rpx;
  height: 190rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;     /* 封面文字居中 */
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  flex-shrink: 0;              /* 封面禁止压缩，保持固定尺寸 */
}
.info {
  flex: 1;                     /* 占据剩余宽度 */
  margin-left: 20rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
}
.author {
  font-size: 24rpx;
  color: #8A7A5C;
  margin: 8rpx 0;
}
.tags {
  display: flex;
  flex-wrap: wrap;             /* 标签过多自动换行 */
  gap: 8rpx;
}
.tag {
  background: #F0E6CE;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
}

/* ====================== 已读切换小按钮（头部右上角） ====================== */
.read-toggle {
  align-self: flex-start;      /* 顶到盒子顶部，形成右上角位置 */
  flex-shrink: 0;              /* 禁止被压缩 */
  margin-left: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #F3E6C4;         /* 未读状态：米黄底 */
  color: #96710A;
  border: 2rpx solid #B8860B;
}
.read-toggle.is-read {
  background: #B8860B;         /* 已读状态：纸黄棕实底 */
  color: #FFFFFF;
  border-color: #B8860B;
}

/* ====================== 通用内容区块 ====================== */
.section {
  width: 100%;                  /* 固定宽度，与头部卡片完全等宽 */
  box-sizing: border-box;       /* 内边距计入宽度，不撑大盒子 */
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.section-label {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}
.section-text {
  font-size: 28rpx;
  color: #8A7A5C;
  line-height: 1.6;            /* 行高，提升大段文字可读性 */
}

/* 本书随笔区块：标题与写随笔按钮同一行 */
.essay-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between; /* 标题靠左，按钮靠右 */
  margin-bottom: 16rpx;
}
.essay-section-header .section-label {
  margin-bottom: 0; /* 行内不再需要单独的下边距 */
}

/* ====================== 本书随笔列表项 ====================== */
.essay-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0E6CE; /* 分割线 */
}
.essay-item:last-child {
  border-bottom: none;
}
.essay-item-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.essay-type {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.essay-type.reading {
  background: #F3E6C4;
  color: #96710A;
}
.essay-type.review {
  background: #FDEBD0;
  color: #C77B1E;
}
.essay-item-title {
  font-size: 28rpx;
  font-weight: 600;
}
.essay-item-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #B3A687;
  margin-top: 10rpx;
}
