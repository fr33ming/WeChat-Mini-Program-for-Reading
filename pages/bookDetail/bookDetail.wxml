<view class="container">
  <!-- 头部 -->
  <view class="hero">
    <image class="cover" src="{{book.cover}}" mode="aspectFill" />
    <view class="info">
      <view class="title">{{book.title}}</view>
      <view class="author">{{book.author}}</view>
      <view class="tags">
        <text class="tag" wx:for="{{book.tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
    <!-- 右上角已读切换小按钮 -->
    <view class="read-toggle {{isRead ? 'is-read' : ''}}" bindtap="toggleRead">
      {{isRead ? '✓ 已读' : '未读'}}
    </view>
  </view>

  <!-- 专业导读 + 写评论 -->
  <view class="section">
    <view class="section-label">🎓 专业导读</view>
    <text class="section-text">{{book.guide}}</text>
  </view>

  <!-- 本书评论 -->
  <view class="section">
    <!-- 标题与写评论按钮同一行：标题靠左，按钮靠右 -->
    <view class="comment-section-header">
      <view class="section-label">✍️ 本书评论 ({{bookComments.length}}条)</view>
      <button class="btn btn-sm" bindtap="goToWrite">✍️ 创作一条评论！</button>
    </view>
    <view wx:if="{{bookComments.length === 0}}" class="empty-state">
      <view class="empty-icon">✍️</view>
      <view>还没有人评论过这本书，来写第一条吧</view>
    </view>
    <view class="comment-item" wx:for="{{bookComments}}" wx:key="_id" bindtap="goToComment" data-id="{{item._id}}">
      <view class="comment-item-top">
        <text class="comment-type {{item.type}}">{{item.typeName}}</text>
        <text class="comment-item-title">{{item.title}}</text>
      </view>
      <view class="comment-item-meta">
        <text>{{item.userName}}</text>
        <text>{{item.time}}</text>
      </view>
    </view>
  </view>
</view>