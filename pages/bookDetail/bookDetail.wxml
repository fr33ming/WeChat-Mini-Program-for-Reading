<view class="container">
  <!-- 头部 -->
  <view class="hero">
    <view class="cover" style="background: {{book.coverColor}}">{{book.cover}}</view>
    <view class="info">
      <view class="title">{{book.title}}</view>
      <view class="author">{{book.author}}</view>
      <view class="tags">
        <text class="tag" wx:for="{{book.tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
    <!-- 右上角已读切换小按钮 -->
    <view class="read-toggle {{isRead ? 'is-read' : ''}}" bindtap="toggleRead">
      {{isRead ? '✓ 已读' : '未读'}}
    </view>
  </view>

  <!-- 内容简介 -->
  <view class="section">
    <view class="section-label">📖 内容简介</view>
    <text class="section-text">{{book.description}}</text>
  </view>

  <!-- 专业导读 + 写随笔 -->
  <view class="section">
    <view class="section-label">🎓 专业导读</view>
    <text class="section-text">{{book.guide}}</text>
  </view>

  <!-- 本书随笔 -->
  <view class="section">
    <!-- 标题与写随笔按钮同一行：标题靠左，按钮靠右 -->
    <view class="essay-section-header">
      <view class="section-label">✍️ 本书随笔 ({{bookEssays.length}}篇)</view>
      <button class="btn btn-sm" bindtap="goToWrite">✍️ 创作一条随笔！</button>
    </view>
    <view wx:if="{{bookEssays.length === 0}}" class="empty-state">
      <view class="empty-icon">✍️</view>
      <view>还没有人写过这本书的随笔，来写第一篇吧</view>
    </view>
    <view class="essay-item" wx:for="{{bookEssays}}" wx:key="_id" bindtap="goToEssay" data-id="{{item._id}}">
      <view class="essay-item-top">
        <text class="essay-type {{item.type}}">{{item.typeName}}</text>
        <text class="essay-item-title">{{item.title}}</text>
      </view>
      <view class="essay-item-meta">
        <text>{{item.userName}}</text>
        <text>{{item.time}}</text>
      </view>
    </view>
  </view>
</view>