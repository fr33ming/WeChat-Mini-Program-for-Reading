/* ====================== 页面底部容器 ====================== */
.container {
  padding-bottom: 40rpx;  /* 页面底部留白，避免内容贴住屏幕底边 */
}

/* ====================== 顶部海报 ====================== */
.poster {
  display: block;
  width: 100%;              /* 海报通栏展示，高度按原图比例自适应 */
}

/* ====================== 顶部吸附搜索栏 ====================== */
.search-bar {
  display: flex;
  padding: 8rpx 24rpx 16rpx;
  background: #F8F1E1;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-input {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  background: #FFFDF8;
  border: 2rpx solid #E7D9B8;
  padding: 0 32rpx;
  font-size: 28rpx;
}

/* ====================== 栏目筛选按钮 ====================== */
.filter-row {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 16rpx;
}
.filter-btn {
  flex: 1;                     /* 四个按钮等分一行 */
  padding: 14rpx 0;
  text-align: center;
  border-radius: 36rpx;
  background: #FFFDF8;
  color: #8A7A5C;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid #E7D9B8;
}
.filter-btn.active {
  background: #B8860B;         /* 选中的按钮用主题色 */
  color: white;
  border-color: #B8860B;
}

/* ====================== 年级选择（横向滚动） ====================== */
.grade-row {
  white-space: nowrap;         /* 子元素不换行，横向滚动 */
  padding: 0 24rpx 16rpx;
  box-sizing: border-box;
}
.grade-btns {
  display: inline-flex;        /* 内联flex，撑开内容宽度供滚动 */
  gap: 12rpx;
}
.grade-btn {
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  background: #FFFDF8;
  color: #8A7A5C;
  font-size: 24rpx;
  border: 2rpx solid #E7D9B8;
}
.grade-btn.active {
  background: #F3E6C4;         /* 选中的年级用浅米黄底 */
  color: #96710A;
  border-color: #B8860B;
}

/* ====================== 书籍列表容器 ====================== */
.book-list {
  padding: 0 24rpx;
}

/* ====================== 单条书籍卡片 ====================== */
.book-card {
  display: flex;
  background: #FFFDF8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.book-cover {
  width: 140rpx;
  height: 190rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  flex-shrink: 0;
}
.book-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.book-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}
.book-author {
  font-size: 24rpx;
  color: #8A7A5C;
  margin-bottom: 8rpx;
}
.book-desc {
  font-size: 22rpx;
  color: #B3A687;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}
.book-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.book-rating {
  font-size: 24rpx;
  color: #C77B1E;
}

/* ====================== 栏目筛选标题 ====================== */
.shelf-header {
  padding: 24rpx 24rpx 16rpx;
}
.shelf-title {
  font-size: 32rpx;
  font-weight: bold;
}

/* ====================== 空状态 ====================== */
.empty-state {
  background: #FFFDF8;
  border-radius: 16rpx;
  padding: 60rpx 20rpx;
  margin: 0 24rpx 20rpx;
  text-align: center;
  color: #B3A687;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

