<view class="container">
  <!-- 首页海报 -->
  <image class="poster" src="/images/poster.png" mode="widthFix" />

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索书名、作者..." bindinput="onSearchInput" value="{{searchTerm}}" />
  </view>

  <!-- 栏目筛选按钮：全部 / 三个栏目（搜索时隐藏） -->
  <view class="filter-row" wx:if="{{!searchTerm}}">
    <view wx:for="{{filters}}" wx:key="key" class="filter-btn {{filterShelf === item.key ? 'active' : ''}}" data-shelf="{{item.key}}" bindtap="onFilterShelf">{{item.label}}</view>
  </view>

  <!-- 年级选择（仅课标必读/分年级拓展时显示，搜索时隐藏） -->
  <scroll-view wx:if="{{!searchTerm && (filterShelf === 'required' || filterShelf === 'grade')}}" class="grade-row" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="grade-btns">
      <view wx:for="{{grades}}" wx:key="value" class="grade-btn {{filterGrade === item.value ? 'active' : ''}}" data-grade="{{item.value}}" bindtap="onFilterGrade">{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 搜索结果（搜索时显示） -->
  <view wx:if="{{searchTerm}}" class="book-list">
    <view wx:if="{{filteredBooks.length === 0}}" class="empty-state">
      <view class="empty-icon">📚</view>
      <view>没有找到相关书籍</view>
    </view>
    <view class="book-card" wx:for="{{filteredBooks}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="book-cover" style="background: {{item.coverColor}}">{{item.cover}}</view>
      <view class="book-info">
        <view class="book-title">{{item.title}}</view>
        <view class="book-author">{{item.author}}</view>
        <view class="book-meta">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="badge badge-primary">{{tag}}</text>
          <text wx:if="{{item.isRead}}" class="badge badge-success">✓ 已读</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 全部：所有图书平铺罗列（无栏目标题） -->
  <block wx:elif="{{filterShelf === 'all'}}">
    <view class="book-card" wx:for="{{books}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="book-cover" style="background: {{item.coverColor}}">{{item.cover}}</view>
      <view class="book-info">
        <view class="book-title">{{item.title}}</view>
        <view class="book-author">{{item.author}}</view>
        <view class="book-desc">{{item.guide}}</view>
        <view class="book-meta">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="badge badge-primary">{{tag}}</text>
          <text wx:if="{{item.isRead}}" class="badge badge-success">✓ 已读</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 栏目/年级筛选结果（顶部显示栏目完整标题） -->
  <block wx:else>
    <view class="shelf-header">
      <view class="shelf-title">{{currentShelfTitle}}</view>
    </view>
    <view wx:if="{{shelfBooks.length === 0}}" class="empty-state">
      <view class="empty-icon">📚</view>
      <view>这个分类下暂时还没有书</view>
    </view>
    <view class="book-card" wx:for="{{shelfBooks}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="book-cover" style="background: {{item.coverColor}}">{{item.cover}}</view>
      <view class="book-info">
        <view class="book-title">{{item.title}}</view>
        <view class="book-author">{{item.author}}</view>
        <view class="book-desc">{{item.guide}}</view>
        <view class="book-meta">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="badge badge-primary">{{tag}}</text>
          <text wx:if="{{item.isRead}}" class="badge badge-success">✓ 已读</text>
        </view>
      </view>
    </view>
  </block>
</view>
