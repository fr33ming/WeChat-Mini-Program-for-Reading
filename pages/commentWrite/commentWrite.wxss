/* ====================== 页面容器 ====================== */
.container {
  padding: 24rpx;
}

/* ====================== 表单卡片 ====================== */
.form-card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

/* ====================== 表单标签 ====================== */
.form-label {
  font-size: 26rpx;
  font-weight: bold;
  margin: 24rpx 0 12rpx;
}
.form-label:first-child {
  margin-top: 0;
}

/* ====================== 书籍选择器 ====================== */
.picker-value {
  background: #F8F1E1;
  border: 2rpx solid #E7D9B8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #4A3B22;
}
.picker-value.placeholder {
  color: #B3A687;
}

/* ====================== 类型选择 ====================== */
.type-row {
  display: flex;
  gap: 20rpx;
}
.type-option {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 40rpx;
  background: #F8F1E1;
  color: #8A7A5C;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid #E7D9B8;
}
.type-option.active {
  background: #B8860B;
  color: white;
  border-color: #B8860B;
}

/* ====================== 标题输入框 ====================== */
.form-input {
  background: #F8F1E1;
  border: 2rpx solid #E7D9B8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

/* ====================== 内容输入区 ====================== */
.form-textarea {
  width: 100%;
  height: 320rpx;
  background: #F8F1E1;
  border: 2rpx solid #E7D9B8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

/* ====================== 发布按钮 ====================== */
.submit-btn {
  width: 100%;
  margin-top: 40rpx;
}
