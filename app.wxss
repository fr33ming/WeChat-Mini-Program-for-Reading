/**app.wxss**/
/* ====================== 全局通用样式（纸黄色主题） ====================== */
/* page：小程序页面根节点，作用于整个页面 */
page {
  background-color: #F8F1E1;  /* 页面整体背景色：纸黄米白 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif; /* 字体栈，优先系统原生字体，兼容iOS、安卓、Windows */
  color: #4A3B22; /* 默认文字颜色：暖棕 */
}

/* ====================== 卡片模块 .card ====================== */
.card {
  background: rgba(255, 253, 248, 0.85);          /* 卡片暖白底 */
  border-radius: 16rpx;        /* 圆角 */
  padding: 24rpx;              /* 卡片内边距 */
  margin: 20rpx 24rpx;         /* 卡片外边距：上下20rpx，左右24rpx */
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); /* 柔和阴影，浮起效果 */
}

/* ====================== 区块标题 .section-title ====================== */
.section-title {
  font-size: 34rpx;            /* 标题字号 */
  font-weight: bold;            /* 加粗 */
  margin: 24rpx 24rpx 12rpx;   /* 外边距：上、左右、下 */
}

/* ====================== 按钮组件 .btn 系列 ====================== */
.btn {
  display: inline-block;        /* 行内块，支持宽高，多个按钮可横向排列 */
  padding: 16rpx 40rpx;        /* 按钮内边距：上下、左右 */
  border-radius: 44rpx;        /* 大圆角，胶囊按钮 */
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  background: rgba(184, 134, 11, 0.9);          /* 主色：纸黄棕 */
  color: white;
  border: none;
}
/* 按钮点击激活态 */
.btn:active {
  background: rgba(150, 113, 10, 0.9);          /* 点击时颜色加深 */
  transform: scale(0.96);       /* 按下轻微缩小，按压反馈 */
}
/* 成功按钮变体 */
.btn-success {
  background: rgba(184, 134, 11, 0.9);          /* 主色 */
}
/* 边框按钮（镂空） */
.btn-outline {
  background: transparent;      /* 透明背景 */
  border: 2rpx solid #B8860B;    /* 纸黄棕描边 */
  color: #B8860B;
}
/* 小号按钮 */
.btn-sm {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
}

/* ====================== 空状态 .empty-state（无数据页面） ====================== */
.empty-state {
  text-align: center;           /* 整体居中 */
  padding: 80rpx 40rpx;
  color: #B3A687;               /* 浅灰棕文字 */
  font-size: 28rpx;
}
.empty-icon {
  font-size: 80rpx;             /* 空状态图标字号 */
  margin-bottom: 20rpx;
}

/* ====================== 标签角标 .badge 徽章 ====================== */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.badge-primary { background: rgba(243, 230, 196, 0.85); color: rgba(150, 113, 10, 0.9); }   /* 主色徽章：米黄底纸黄棕字 */
.badge-success { background: rgba(240, 227, 190, 0.85); color: #7A5C1E; }   /* 已读徽章：浅米底深棕字 */
.badge-warning { background: rgba(253, 235, 208, 0.85); color: #C77B1E; }  /* 警示徽章：浅杏底橙字 */
